# Security headers for every response from Cloudflare Workers static assets
# (https://developers.cloudflare.com/workers/static-assets/headers/).
#
# Content-Security-Policy: the app loads only its own scripts, styles, fonts
# and images; the only other server it talks to is Supabase (production and
# staging, for preview builds), when the captcha is switched on, Cloudflare
# Turnstile, and, once an Umami website ID is set (vite.config.ts), Umami Cloud
# on the landing pages and the trainer's page. Adding a third-party service means adding it here, and to the
# privacy policy.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://cloud.umami.is; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://ubjwlxcawxwrgolszlkz.supabase.co https://dghypouxfnfcdvpylznt.supabase.co https://cloud.umami.is https://api-gateway.umami.dev; manifest-src 'self'; worker-src 'none'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=()

# Built files carry a content hash in their name, so a changed file gets a
# new address: browsers can keep them for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The logo in the sign-in e-mails is loaded by mail apps from other sites;
# without this, webmail in a browser would block it (same-origin above).
/email/*
  ! Cross-Origin-Resource-Policy
  Cache-Control: public, max-age=31536000, immutable
